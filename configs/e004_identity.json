{
  "experiment": "E004_IDENTITY",
  "output": "outputs/E004_identity",
  "data_root": "data/Wildtrack_dataset",
  "roi_m": [
    -3.0,
    9.0,
    -9.0,
    27.0
  ],
  "gate_m": 1.0,
  "frame_number_hz": 10,
  "max_switch_time": "infinity",
  "solver": "scipy",

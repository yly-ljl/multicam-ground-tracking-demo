  "segments": {
    "old_development": {
      "frame_start": 0,
      "frame_stop": 500,
      "frame_step": 5,
      "track_sources": {
        "C1": "outputs/E003_improvement/development/C1/tracks.csv",
        "B2": "outputs/E003_improvement/development/B2/tracks.csv",
        "B3": "outputs/E003_improvement/development/B3/tracks.csv"
      }
    },
    "new_development": {
      "frame_start": 500,
      "frame_stop": 800,
      "frame_step": 5,
      "track_sources": {
        "C1": "outputs/E004_identity/new_development/C1/tracks.csv",
        "B2": "outputs/E004_identity/new_development/B2/tracks.csv",
        "B3": "outputs/E004_identity/new_development/B3/tracks.csv"
      }
    },
    "seen_reference": {
      "frame_start": 800,
      "frame_stop": 1400,
      "frame_step": 5,
      "track_sources": {
        "C1": "outputs/E003_improvement/validation/C1/tracks.csv",
        "B2": "outputs/E003_improvement/validation/B2/tracks.csv",
        "B3": "outputs/E003_improvement/validation/B3/tracks.csv"
      }
    }
  }
}